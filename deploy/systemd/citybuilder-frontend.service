[Unit]
Description=CityBuilder frontend
After=network-online.target citybuilder-backend.service
Wants=network-online.target

[Service]
Type=simple
User=sambhav
Group=sambhav
WorkingDirectory=/home/sambhav/CityBuilder/frontend
ExecStart=/home/sambhav/CityBuilder/frontend/node_modules/.bin/vite preview --host 0.0.0.0 --port 5173
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
